{
  "name": "nft-academic-certificate-issuance-and-verification",
  "version": "1.0.0",
  "description": "Team 4 NFT academic certificate issuance and verification on Ganache",
  "main": "index.js",
  "scripts": {
    "chain": "node scripts/tool.js ganache --server.port 7545 --chain.chainId 1337 --chain.networkId 5777 --chain.hardfork shanghai --wallet.deterministic --database.dbPath ./.ganache-db",
    "compile": "node scripts/tool.js hardhat compile",
    "test": "node scripts/tool.js hardhat test",
    "test:ganache": "node scripts/tool.js hardhat test --network ganache",
    "deploy": "node scripts/tool.js hardhat run scripts/deploy.js --network ganache",
    "deploy:gui": "node scripts/deploy-gui.js",
    "gas": "node scripts/tool.js hardhat run scripts/gas.js --network ganache",
    "verify": "node scripts/verify.js",
    "transactions": "node scripts/transactions.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbt2005/NFT-Academic-Certificate-Issuance-and-Verification---Team-4.git"
  },
